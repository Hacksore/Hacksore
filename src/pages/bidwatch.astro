---
import { isbot } from "isbot";
import Layout from "../layouts/layout.astro";

const BIDWATCH_URL = "https://bidwatch.app";

const userAgent = Astro.request.headers.get("user-agent") ?? "";

// Real users get a 301 to bidwatch.app, bots/crawlers (and empty UAs) get a
// static page with open graph tags so link previews still work.
if (userAgent && !isbot(userAgent)) {
  return Astro.redirect(BIDWATCH_URL, 301);
}

const META_INFO = {
  title: "Bidwatch",
  description: "Bidwatch - https://bidwatch.app",
};
---

<Layout title={META_INFO.title} description={META_INFO.description}>
  <div class="prose prose-invert">
    <h1>Bidwatch</h1>
    <p><a href={BIDWATCH_URL}>{BIDWATCH_URL}</a></p>
  </div>
</Layout>
