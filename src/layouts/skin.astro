---
// Keep this document independent of the site layout and its navigation/analytics.
Astro.response.headers.set(
  "Content-Security-Policy",
  "frame-ancestors 'self' https://x.com https://twitter.com https://*.x.com https://*.twitter.com",
);
const site = Astro.site ?? new URL("https://seanboult.dev");
const player = new URL("/skin/embed", site).href;
const preview = new URL("/img/minecraft-og.png", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Minecraft Skin</title>
    <meta name="description" content="Interactive 3D skin viewer">
    <meta name="twitter:card" content="player">
    <meta name="twitter:site" content="@Hacksore">
    <meta name="twitter:title" content="Minecraft Skin">
    <meta name="twitter:description" content="Interactive 3D skin viewer">
    <meta name="twitter:player" content={player}>
    <meta name="twitter:player:width" content="480">
    <meta name="twitter:player:height" content="480">
    <meta name="twitter:image" content={preview}>
    <meta property="og:title" content="Minecraft Skin">
    <meta property="og:description" content="Interactive 3D skin viewer">
    <meta property="og:image" content={preview}>
  </head>
  <body class="skin-page">
    <canvas
      id="skin"
      aria-label="Hacksore's Minecraft skin. Drag to rotate; scroll or pinch to zoom."
    ></canvas>
    <span id="status" role="status">Loading…</span>
    <form id="skin-loader" aria-label="Load a Minecraft skin">
      <input
        id="username"
        name="username"
        aria-label="Minecraft username"
        value="Hacksore"
        placeholder="Minecraft username"
        pattern="[A-Za-z0-9_]{1,16}"
        maxlength="16"
        required
        autocomplete="off"
        data-1p-ignore
        autocapitalize="off"
        spellcheck="false"
      >
      <button type="submit" aria-label="Load skin" aria-busy="true" disabled>
        <span class="load-label">Load</span>
        <span class="load-spinner" aria-hidden="true"></span>
      </button>
    </form>
    <script>
    import { SkinViewer } from "skinview3d";

    const canvas = document.querySelector<HTMLCanvasElement>("#skin");
    const status = document.querySelector<HTMLSpanElement>("#status");
    const form = document.querySelector<HTMLFormElement>("#skin-loader");
    const username = document.querySelector<HTMLInputElement>("#username");
    const button = form?.querySelector("button");
    if (!canvas || !status || !form || !username || !button) {
      throw new Error("Missing skin viewer elements");
    }
    try {
      const viewer = new SkinViewer({
        canvas,
        width: window.innerWidth,
        height: window.innerHeight,
        pixelRatio: Math.min(window.devicePixelRatio, 2),
      });
      viewer.controls.enableZoom = true;
      viewer.controls.enableRotate = true;
      viewer.controls.enablePan = false;
      viewer.autoRotate = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      viewer.autoRotateSpeed = 0.5;
      viewer.camera.position.set(20, 10, 50);
      viewer.controls.update();

      const resize = new ResizeObserver(() => {
        viewer.setSize(window.innerWidth, window.innerHeight);
      });
      resize.observe(document.body);
      // Pause offscreen embeds rather than continually using the GPU.
      const visibility = () => {
        viewer.renderPaused = document.hidden;
      };
      document.addEventListener("visibilitychange", visibility);
      visibility();
      window.addEventListener("pagehide", (event) => {
        if (event.persisted) return;
        resize.disconnect();
        document.removeEventListener("visibilitychange", visibility);
        viewer.dispose();
      });

      let loading = true;
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (loading || !form.reportValidity()) return;
        const name = username.value;
        loading = true;
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        status.hidden = true;
        try {
          await viewer.loadSkin(`https://mineskin.eu/skin/${encodeURIComponent(name)}`);
          // The local cape belongs to Hacksore, not to other players.
          if (name.toLowerCase() !== "hacksore") viewer.loadCape(null);
          else await viewer.loadCape("/img/cape-2011.png");
          viewer.nameTag = name;
          canvas.setAttribute(
            "aria-label",
            `${name}'s Minecraft skin. Drag to rotate; scroll or pinch to zoom.`,
          );
        } catch {
          status.textContent = "Unable to load that skin. Check the username and try again.";
          status.hidden = false;
        } finally {
          loading = false;
          button.disabled = false;
          button.setAttribute("aria-busy", "false");
        }
      });

      Promise.all([
        viewer.loadSkin("/img/Hacksore.png"),
        viewer.loadCape("/img/cape-2011.png"),
        document.fonts.load("48px Minecraft", "Hacksore"),
      ])
        .then(() => {
          viewer.nameTag = "Hacksore";
          status.hidden = true;
        })
        .catch(() => {
          status.textContent = "Unable to load skin.";
        })
        .finally(() => {
          loading = false;
          button.disabled = false;
          button.setAttribute("aria-busy", "false");
        });
    } catch {
      status.textContent = "3D viewing requires WebGL.";
    }
    </script>
  </body>
</html>

<style is:global>
@font-face {
  font-family: "Minecraft";
  src: url("skinview3d/assets/minecraft.woff2") format("woff2");
  font-style: normal;
  font-weight: 400;
  font-display: swap;
}

body.skin-page {
  position: fixed;
  inset: 0;
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #101014;
}
#skin {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}
#status {
  position: fixed;
  bottom: calc(76px + env(safe-area-inset-bottom));
  left: 0;
  width: 100%;
  text-align: center;
  color: #aaa;
  font:
    12px system-ui,
    sans-serif;
  pointer-events: none;
}
#skin-loader {
  position: fixed;
  bottom: calc(20px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  width: min(340px, calc(100% - 32px));
}
#skin-loader input,
#skin-loader button {
  box-sizing: border-box;
  border: 1px solid #44444c;
  border-radius: 4px;
  padding: 12px;
  font:
    16px "Minecraft",
    monospace;
  color: #fff;
  background: #1b1b21;
}
#skin-loader input {
  flex: 1;
  min-width: 0;
}
#skin-loader button {
  position: relative;
  flex: 0 0 88px;
  cursor: pointer;
  background: #303039;
}
#skin-loader button[aria-busy="true"] .load-label {
  visibility: hidden;
}
#skin-loader .load-spinner {
  display: none;
  position: absolute;
  inset: 0;
  margin: auto;
  width: 16px;
  height: 16px;
  border: 2px solid #ffffff40;
  border-top-color: #fff;
  border-radius: 50%;
  animation: skin-load-spin 0.8s linear infinite;
}
#skin-loader button[aria-busy="true"] .load-spinner {
  display: block;
}
@keyframes skin-load-spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  #skin-loader .load-spinner {
    animation: none;
  }
}
#skin-loader button:hover:not(:disabled) {
  background: #43434e;
}
#skin-loader button:disabled {
  opacity: 0.55;
  cursor: wait;
}
#skin-loader input:focus {
  outline: none;
}
#skin-loader button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}
</style>
